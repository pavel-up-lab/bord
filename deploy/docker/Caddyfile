{
	auto_https off
	servers {
		# Preserve the address set by the only public reverse proxy. This edge has
		# no published host port, so requests cannot bypass that trusted network.
		trusted_proxies static {$BORD_UPSTREAM_PROXY_CIDRS:172.18.0.0/16}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

:8088 {
	# Compression can buffer small chunks, so keep it outside the SSE chain.
	@not_events not path /api/v1/events
	encode @not_events zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	@events path /api/v1/events
	handle @events {
		reverse_proxy backend:8080 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	@backend path /api/* /healthz /readyz
	handle @backend {
		reverse_proxy backend:8080
	}

	handle_path /downloads/* {
		root * /srv/downloads
		file_server
	}

	handle {
		root * /srv/landing
		file_server
	}
}
